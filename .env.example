# =============================================================
# Candidate Screening Platform — Environment Variables
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is listed in .gitignore.
# =============================================================


# ---------------------------------------------------------
# LangSmith (optional — for LangGraph tracing)
# ---------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-demo


# ---------------------------------------------------------
# LLM — Groq
# ---------------------------------------------------------
GROQ_API_KEY=

# Model to use (default: qwen/qwen3-8b)
# LLM_MODEL=qwen/qwen3-8b

# Generation parameters (optional)
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048


# ---------------------------------------------------------
# GitHub API
# Required for repository-level GitHub analysis.
# ---------------------------------------------------------
GITHUB_TOKEN=


# ---------------------------------------------------------
# Email — Resend
# https://resend.com/api-keys
# ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=amssre.15001@gmail.com
TEST_LINK=
TEST_PASSING_SCORE=70


# ---------------------------------------------------------
# LLM Rate Limiting
#
# The Groq free tier enforces ~8 000 tokens per minute (TPM).
# These settings protect against 429 rate-limit errors.
#
#   LLM_TPM_LIMIT          — max tokens per 60-second window
#   LLM_BATCH_SIZE         — candidates per evaluation batch
#                            (keep at 1 for safest operation)
#   LLM_BATCH_WAIT_SECONDS — seconds to wait between batches
#   LLM_MAX_RETRIES        — retry attempts on 429 / errors
#   LLM_RETRY_BASE_WAIT    — base seconds for exponential backoff
# ---------------------------------------------------------
LLM_TPM_LIMIT=8000
LLM_BATCH_SIZE=1
LLM_BATCH_WAIT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_WAIT=5


# ---------------------------------------------------------
# Database (PostgreSQL — asyncpg)
# ---------------------------------------------------------
# Railway provides PORT and DATABASE_URL automatically.
PORT=8000
# Railway provides DATABASE_URL automatically when PostgreSQL is attached.
# For local development, use POSTGRE_DB_URL or DATABASE_URL.
POSTGRE_DB_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/screening_db
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/screening_db

# Docker Compose PostgreSQL settings (local only)
POSTGRES_DB=screeneasy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Resend
EMAIL_REPLY_TO=amssre.15001@gmail.com

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

